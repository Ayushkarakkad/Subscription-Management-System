            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Support Level\",\n  \"value\": \"24/7 Dedicated\",\n  \"priceExtra\": 1500.00\n}"
            },
            "url": { "raw": "{{baseUrl}}/products/{{productId}}/variants", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}", "variants"] }
          }
        },
